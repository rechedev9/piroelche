# No se activa ningún receptor por defecto. Estas variables son SOLO de servidor.
LEADS_RECEIVER_MODE=disabled
LEADS_RECEIVER_URL=
LEADS_RECEIVER_TOKEN=
LEADS_ALLOWED_ORIGINS=
LEADS_RECEIVER_TIMEOUT_MS=8000

# Prueba local explícita (Node 24 LTS). Copiar a .env.local, generar un token propio
# de 32+ caracteres y poner mode=local-test, URL=http://127.0.0.1:4010/leads.
# Mismo token en Next y receptor. Orígenes separados por comas si se especifican.
# LEADS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LEADS_LOCAL_PORT=4010
# Directorio dedicado privado; vacío usa LOCALAPPDATA/Piroboom/local-test-receiver
# en Windows. No usar public, un directorio de compilación ni un volumen efímero.
# LEADS_LOCAL_STORAGE_DIR=
LEADS_RETENTION_DAYS=30
LEADS_IDEMPOTENCY_DAYS=90

# Solo un proxy propio que BORRE y reescriba X-Forwarded-For. Vercel usa su cabecera
# administrada. Sin proxy fiable, todos los clientes comparten un límite prudente.
LEADS_TRUST_PROXY=0

# Para fixtures visuales, solo revisión local; el servidor de contenido exige ambas
# variables y bloquea ese contexto cuando existe VERCEL. Nunca usar para publicar.
PIROBOOM_DEMO=0
PIROBOOM_LOCAL_REVIEW=0
# Solo ensayo local de campañas ficticias (fechas y popup), nunca datos del negocio.
# La demo normal conserva las cuatro casetas de la página oficial.
REVIEW_CAMPAIGNS=0

# URL canónica y permiso de indexación. Preview/local siempre noindex por defecto.
# PIROBOOM_PUBLIC_SITE=1 exige textos legales publicados en validate:content.
PIROBOOM_SITE_URL=https://pirotecniaelche.es
PIROBOOM_PUBLIC_SITE=0
# Token de Google Search Console (meta google-site-verification). Vacío = no se emite.
PIROBOOM_GOOGLE_SITE_VERIFICATION=
# Solo muestra el diálogo si además hay una campaña confirmada y vigente.
PIROBOOM_PROMO=0

# Actualización del catálogo desde una carpeta privada de Google Drive.
# Configurar estas variables también en el hosting; pnpm build ejecuta la importación.
# Ver docs/catalogue-sync.md. Mantener desactivado hasta conectar Drive y el despliegue.
CATALOGUE_SYNC_ENABLED=0
CATALOGUE_DRIVE_FOLDER_ID=
CATALOGUE_DRIVE_FILE_NAME=catalogo.pdf
# JSON completo de una cuenta de servicio con acceso de lector a esa carpeta.
# Guardar como secreto del hosting, nunca en el repositorio.
CATALOGUE_GOOGLE_SERVICE_ACCOUNT_JSON=
# Opcional si la portada no contiene un único año de edición legible.
CATALOGUE_EDITION=
# Para comprobar versiones y solicitar despliegues; la tarea diaria queda pendiente.
# El manifiesto es público, el hook es secreto.
CATALOGUE_PUBLISHED_MANIFEST_URL=https://pirotecniaelche.es/media/catalogo-2026/manifest.json
CATALOGUE_DEPLOY_HOOK_URL=
