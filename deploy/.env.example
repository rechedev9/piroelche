# Canonical origin baked into metadata at build time and read at runtime.
# Replace this example with Keko's real HTTPS origin before building.
PIROBOOM_SITE_URL=https://catalogo.example.com
# 0 keeps X-Robots-Tag: noindex. Set to 1 only for the real public domain,
# and only once validate:content passes with the legal texts published.
PIROBOOM_PUBLIC_SITE=0
PIROBOOM_PROMO=0

# Lead receiver (server-only). Leave disabled until a receiver is deployed.
LEADS_RECEIVER_MODE=disabled
LEADS_RECEIVER_URL=
LEADS_RECEIVER_TOKEN=
LEADS_ALLOWED_ORIGINS=
