# Example for Keko's VPS: replace the hostname and add to its Caddy config.
# Validate before reloading, preserving all other sites.
# This assumes Caddy can reach the host loopback. A containerized proxy with
# its own network needs a different upstream/network configuration.
# The app already sets its own security headers in next.config.ts.

catalogo.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8093
}
